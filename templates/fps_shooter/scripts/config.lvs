    "name": "Rifle",
    "damage": 22,
    "rpm": 640,               # выстрелов в минуту -> задержка между выстрелами
    "magazine": 30,
    "reserve": 120,
    "reloadSeconds": 1.9,
    "range": 90.0,
    "spreadBase": 0.006,      # радианы
    "spreadPerShot": 0.010,
    "spreadMax": 0.075,
    "spreadRecover": 0.16,    # спад разброса в секунду
    "recoilPitch": 1.1,       # градусы на выстрел (подброс камеры)
    "headshotMult": 2.0,
}

