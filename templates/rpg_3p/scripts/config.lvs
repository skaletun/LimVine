global CFG_NPC_CHASE_SPEED = 3.4
global CFG_NPC_AGGRO_RANGE = 9.0
global CFG_NPC_ATTACK_RANGE = 1.9
global CFG_NPC_ATTACK_DAMAGE = 7
global CFG_NPC_HP = 45
global CFG_NPC_FLEE_HP = 12       # порог бегства (демонстрация перехода FSM)

# ---- Точки интереса --------------------------------------------------------
global SPAWN_PLAYER = {"x": 0.0, "y": 0.5, "z": 6.0}
global SPAWN_ELDER = {"x": -4.0, "y": 0.5, "z": -2.0}
global SPAWN_SMITH = {"x": 5.0, "y": 0.5, "z": -4.0}
global SPAWN_WOLF_A = {"x": 12.0, "y": 0.5, "z": 10.0}
global SPAWN_WOLF_B = {"x": -13.0, "y": 0.5, "z": 12.0}
global CAMPFIRE = {"x": 0.0, "y": 0.2, "z": 0.0}

/// Ограничить точку границами мира (NPC не должны уходить за карту).
func clampToWorld(p) do
    let h = CFG_WORLD_SIZE * 0.5 - 1.0
    return vec3(math.clamp(p.x, -h, h), p.y, math.clamp(p.z, -h, h))
end

