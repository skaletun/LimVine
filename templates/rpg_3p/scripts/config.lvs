import math

# ---- Мир -------------------------------------------------------------------
global CFG_WORLD_SIZE = 44        # сторона квадратной карты, м
global CFG_NAV_CELLS = 22         # разрешение навигационной сетки (A*)
global CFG_NAV_CELL_SIZE = 2.0    # = CFG_WORLD_SIZE / CFG_NAV_CELLS

# ---- Игрок -----------------------------------------------------------------
