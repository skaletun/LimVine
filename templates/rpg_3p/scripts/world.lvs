# ============================================================================
#  Third-Person RPG — мир и навигация
#
#  Мир собирается процедурно из примитивов (в реальном проекте — из .lvscene и
#  ассетов), а проходимая область описывается навигационной сеткой GridNav из
#  stdlib/pathfinding.lvs: NPC ищут путь A* по ней, поэтому их движение
#  обходит дома и костёр, а не идёт сквозь них.
# ============================================================================

class RpgWorld do
    var nav                   # GridNav (stdlib/pathfinding)
    var ground
    var buildings
    var campfire
    var interactables         # map id -> {entity, kind, label}

    func init() do
        this.nav = nil
        this.ground = nil
        this.buildings = []
        this.campfire = nil
        this.interactables = {}
    end

    /// Построить геометрию и навигационную сетку.
    func build() do
        this.ground = spawn()
        setPosition(this.ground, vec3(0, -0.1, 0))
        setField(this.ground, "Transform", "scale", vec3(CFG_WORLD_SIZE, 0.2, CFG_WORLD_SIZE))
        setField(this.ground, "MeshRenderer", "tint", color(0.36, 0.47, 0.30, 1.0))

        this.nav = new GridNav(CFG_NAV_CELLS, CFG_NAV_CELLS)
        this.nav.allowDiagonal = true

        # Два дома и колодец: одновременно геометрия И препятствия для A*.
        this.addBuilding("house_a", vec3(-6.0, 0.0, -4.0), vec3(4.0, 3.0, 4.0), color(0.52, 0.38, 0.26, 1.0))
        this.addBuilding("house_b", vec3(7.0, 0.0, -6.0), vec3(4.0, 3.0, 4.0), color(0.46, 0.34, 0.24, 1.0))
        this.addBuilding("well", vec3(1.0, 0.0, 2.5), vec3(1.2, 1.0, 1.2), color(0.62, 0.62, 0.66, 1.0))

        # Частокол по периметру: A* честно ищет выход через ворота.
        var i = 0
        while i < CFG_NAV_CELLS do
            if i != CFG_NAV_CELLS / 2 do
                this.nav.block(i, 0)
                this.nav.block(i, CFG_NAV_CELLS - 1)
                this.nav.block(0, i)
                this.nav.block(CFG_NAV_CELLS - 1, i)
            end
            i += 1
        end

        this.campfire = spawn()
        setPosition(this.campfire, vec3(CAMPFIRE["x"], CAMPFIRE["y"], CAMPFIRE["z"]))
        setField(this.campfire, "Transform", "scale", vec3(0.9, 0.5, 0.9))
        setField(this.campfire, "MeshRenderer", "tint", color(0.95, 0.55, 0.15, 1.0))
        this.registerInteractable("campfire", this.campfire, "rest", "Rest at the campfire")
        return this
    end

    /// Дом/колодец: сущность + непроходимые клетки навигационной сетки.
    func addBuilding(id: String, pos, size, tint) do
        let e = spawn()
        setPosition(e, pos)
        setField(e, "Transform", "scale", size)
        setField(e, "MeshRenderer", "tint", tint)
        # Физическое тело: персонажи и волки в него упираются.
        addRigidBody(e, vec3(size.x * 0.5, size.y * 0.5, size.z * 0.5), 0)   # 0 = Static
        this.buildings.push({"id": id, "entity": e, "pos": pos, "size": size})
        this.blockNavBox(pos, size)
        return e
    end

    /// Отметить клетки сетки, занятые коробкой (с запасом в полклетки).
    func blockNavBox(pos, size) do
        let pad = CFG_NAV_CELL_SIZE * 0.6
        let minC = this.worldToNav(vec3(pos.x - size.x * 0.5 - pad, 0, pos.z - size.z * 0.5 - pad))
        let maxC = this.worldToNav(vec3(pos.x + size.x * 0.5 + pad, 0, pos.z + size.z * 0.5 + pad))
        var gz = minC["z"]
        while gz <= maxC["z"] do
            var gx = minC["x"]
            while gx <= maxC["x"] do
                if this.nav.inside(gx, gz) do this.nav.block(gx, gz) end
                gx += 1
            end
            gz += 1
        end
        return nil
    end

    /// Мировые координаты -> клетка навигационной сетки.
    func worldToNav(p) do
        let half = CFG_WORLD_SIZE * 0.5
        let gx = int(math.floor((p.x + half) / CFG_NAV_CELL_SIZE))
        let gz = int(math.floor((p.z + half) / CFG_NAV_CELL_SIZE))
        return {"x": gx, "z": gz}
    end

    /// Клетка навигационной сетки -> мировые координаты (центр клетки).
    func navToWorld(gx, gz) do
        let half = CFG_WORLD_SIZE * 0.5
        return vec3(gx * CFG_NAV_CELL_SIZE - half + CFG_NAV_CELL_SIZE * 0.5, 0.0,
                    gz * CFG_NAV_CELL_SIZE - half + CFG_NAV_CELL_SIZE * 0.5)
    end

    /// Построить путь A* между двумя мировыми точками.
    ///
    /// GridNav работает в плоскости (x, y) своей сетки, а наш мир лежит в
    /// плоскости XZ, поэтому ось Z отображается на "y" навигационной клетки.
    func findPath(fromPos, toPos) do
        let a = this.worldToNav(fromPos)
        let b = this.worldToNav(toPos)
        let raw = this.nav.findPath({"x": a["x"], "y": a["z"]}, {"x": b["x"], "y": b["z"]})
        var out = []
        for cell in raw do out.push(this.navToWorld(cell["x"], cell["y"])) end
        return out
    end

    /// Зарегистрировать объект, с которым можно взаимодействовать.
    func registerInteractable(id: String, ent, kind: String, label: String) do
        this.interactables[id] = {"entity": ent, "kind": kind, "label": label, "id": id}
        return id
    end

    /// Ближайший интерактивный объект в радиусе reach (или nil).
    func nearestInteractable(pos, reach) do
        var best = nil
        var bestD = reach
        for k, it in this.interactables do
            let d = vec3Distance(pos, getPosition(it["entity"]))
            if d <= bestD do
                bestD = d
                best = it
            end
        end
        return best
    end
end
